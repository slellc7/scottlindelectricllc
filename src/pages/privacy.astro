---
import Base from '../layouts/Base.astro';
import Crumb from '../components/Crumb.astro';
import PageHeading from '../components/PageHeading.astro';
import { SITE } from '../consts';

const effectiveDate = 'August 17, 2026';
const smsNumber = '(208) 516-2090';
---

<Base
  title="Privacy Policy | Scott Lind Electric"
  description="Privacy policy and SMS messaging terms for Scott Lind Electric LLC, including how customer information is collected, used, protected, and shared."
  breadcrumb="Privacy Policy"
>
  <Crumb trail={['Privacy Policy']} />

  <section class="section section--page legal-page">
    <PageHeading kicker={`Effective ${effectiveDate}`} size="h-page--sm" tight>
      Privacy Policy
    </PageHeading>
    <p class="lead lead--narrow gap-lead">
      This policy explains how {SITE.legalName} collects, uses, and protects information when you
      contact us, request electrical service, use our website assistant, or communicate with us by
      text message.
    </p>

    <div class="legal-grid">
      <article class="legal-content">
        <section id="information-we-collect">
          <h2>Information we collect</h2>
          <p>
            We may collect your name, phone number, email address, service address, details about
            the electrical issue, messages you send us, communication preferences, and basic
            technical information generated when you use this website.
          </p>
        </section>

        <section id="how-we-use-information">
          <h2>How we use information</h2>
          <p>
            We use this information to respond to service requests, communicate about scheduling
            and service updates, provide estimates, maintain business records, improve our service,
            prevent misuse, and comply with legal obligations.
          </p>
        </section>

        <section id="cookies-analytics">
          <h2>Cookies and analytics</h2>
          <p>
            This website uses Google Analytics and similar technologies to understand visits and
            improve the site. These tools may collect device and browser information, pages viewed,
            approximate location derived from an IP address, and interaction data. You can limit
            cookies through your browser settings, although some website features may not work as
            intended.
          </p>
        </section>

        <section id="sms-terms" class="sms-section">
          <h2>SMS opt-in and terms</h2>
          <p class="sms-disclosure">
            Customers opt in by visiting <a href="https://scottlindelectric.com/privacy/"
              >https://scottlindelectric.com/privacy/</a
            >, where they are instructed to text START to (208) 516-2090 and explicitly agree to
            receive SMS messages from Scott Lind Electric. Messages concern electrical-service
            requests, scheduling, and service updates and may initially be handled by an AI
            assistant. Message frequency varies. Message and data rates may apply. Reply HELP for
            help or STOP to opt out.
          </p>
          <p>
            By texting <strong>START</strong> to {smsNumber}, you expressly consent to receive
            service-related text messages from Scott Lind Electric at the number you use. Consent
            is not a condition of purchasing services. You may withdraw consent at any time by
            replying <strong>STOP</strong>. For assistance, reply <strong>HELP</strong> or call
            <a href={SITE.telHref}>{SITE.phone}</a>. Carriers are not liable for delayed or
            undelivered messages.
          </p>
          <a class="btn btn-primary blueprint btn-md" href="sms:+12085162090?body=START">
            Text START to {smsNumber}
          </a>
        </section>

        <section id="ai-assistant">
          <h2>AI-assisted communications</h2>
          <p>
            Our website chat and some initial communications may be handled by an AI assistant.
            The assistant helps collect service-request details and is not a substitute for an
            electrician, emergency responder, or professional safety advice. Do not provide payment
            card information or other sensitive information in chat or text messages.
          </p>
        </section>

        <section id="sharing">
          <h2>How information is shared</h2>
          <p>
            We may share information with service providers that help us operate our website,
            communications, data storage, and customer service, or when disclosure is required by
            law. We do not sell your personal information.
          </p>
          <p>
            Mobile information, text-messaging originator opt-in data, and consent will not be
            shared with third parties or affiliates for their marketing or promotional purposes.
          </p>
        </section>

        <section id="retention-security">
          <h2>Retention and security</h2>
          <p>
            We keep information only as long as reasonably necessary for the purposes described in
            this policy, our business records, dispute resolution, and legal compliance. We use
            reasonable administrative and technical safeguards, but no internet transmission or
            storage system can be guaranteed completely secure.
          </p>
        </section>

        <section id="choices">
          <h2>Your choices</h2>
          <p>
            You may ask to review, correct, or delete personal information we maintain about you,
            subject to legal and recordkeeping requirements. You can opt out of text messages by
            replying STOP and can choose not to use the website assistant by calling us directly.
          </p>
        </section>

        <section id="updates">
          <h2>Policy updates</h2>
          <p>
            We may update this policy as our practices or legal obligations change. The effective
            date at the top of this page identifies the latest version.
          </p>
        </section>

        <section id="contact-us">
          <h2>Contact us</h2>
          <address>
            <strong>{SITE.legalName}</strong><br />
            {SITE.address.street}<br />
            {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}<br />
            <a href={SITE.telHref}>{SITE.phone}</a><br />
            <a href="mailto:scott@scottlindelectric.com">scott@scottlindelectric.com</a>
          </address>
        </section>
      </article>

      <aside class="legal-nav" aria-label="Privacy policy sections">
        <strong>On this page</strong>
        <a href="#information-we-collect">Information we collect</a>
        <a href="#how-we-use-information">How we use information</a>
        <a href="#cookies-analytics">Cookies and analytics</a>
        <a href="#sms-terms">SMS opt-in and terms</a>
        <a href="#ai-assistant">AI communications</a>
        <a href="#sharing">Information sharing</a>
        <a href="#retention-security">Retention and security</a>
        <a href="#choices">Your choices</a>
        <a href="#contact-us">Contact us</a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .legal-page { padding-bottom: 96px; }
  .legal-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(210px, 1fr);
    gap: 72px;
    align-items: start;
  }
  .legal-content { min-width: 0; }
  .legal-content section { scroll-margin-top: 120px; padding: 34px 0; border-top: 1px solid var(--color-divider); }
  .legal-content section:first-child { border-top: 0; padding-top: 0; }
  .legal-content h2 { margin: 0 0 12px; font-size: clamp(1.4rem, 2vw, 1.85rem); text-transform: uppercase; }
  .legal-content p { max-width: 70ch; margin: 0 0 16px; line-height: 1.75; color: color-mix(in srgb, var(--color-text) 72%, transparent); }
  .legal-content a:not(.btn) { color: var(--color-accent); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .legal-content address { font-style: normal; line-height: 1.7; }
  .sms-section { padding: 34px !important; border: 1px solid var(--color-divider) !important; background: var(--color-surface); }
  .sms-disclosure { color: var(--color-text) !important; font-weight: 650; }
  .legal-nav { position: sticky; top: 110px; display: grid; gap: 10px; padding: 24px; border-left: 3px solid var(--color-accent); background: var(--color-surface); }
  .legal-nav strong { margin-bottom: 4px; text-transform: uppercase; }
  .legal-nav a { color: color-mix(in srgb, var(--color-text) 65%, transparent); text-decoration: none; }
  .legal-nav a:hover, .legal-nav a:focus-visible { color: var(--color-accent); }
  @media (max-width: 820px) {
    .legal-page { padding-bottom: 64px; }
    .legal-grid { grid-template-columns: 1fr; gap: 36px; }
    .legal-nav { position: static; grid-row: 1; }
    .sms-section { padding: 24px !important; }
  }
</style>
