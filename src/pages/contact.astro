---
import PageHeading from '../components/PageHeading.astro';
import Base from '../layouts/Base.astro';
import Corners from '../components/Corners.astro';
import Crumb from '../components/Crumb.astro';
import ServiceMap from '../components/ServiceMap.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { SITE } from '../consts';
---

<Base
  title="Contact Scott Lind Electric | Free Idaho Falls Estimate"
  description="Call 208.716.1240 or request a free estimate from Scott Lind Electric, 1302 Taylor Avenue, Idaho Falls, ID 83404. No service-call fee within 50 miles."
  breadcrumb="Contact"
>
  <Crumb trail={['Contact']} />

  <section class="section section--page">
    <div class="contact-intro">
      <PageHeading kicker={`Get in touch · Idaho Falls`} size="h-page--sm" tight>
        Free estimate.<br />No service&#8209;call fee.
      </PageHeading>
      <p class="lead lead--sm gap-lead">
        Tell us what you need, or call for the fastest response. For anything urgent, please call
        us directly.
      </p>
    </div>

    <div class="contact-grid">
      <div class="blueprint panel panel--tint panel--wide contact-card">
        <Corners />
        <h2 class="panel-title-lg">Request an estimate</h2>
        <p class="panel-intro">
          Tell us what it's doing and where you are. We'll come back with a plan and a price.
        </p>
        <EstimateForm source="Contact page — request an estimate" idPrefix="c" full />
      </div>

      <div class="blueprint panel panel--wide contact-card contact-card--info">
        <Corners />
        <h2 class="panel-title-lg">{SITE.legalName}</h2>
        <p class="panel-intro">Call Scott directly for service questions and urgent electrical needs.</p>

        <a href={SITE.telHref} class="btn btn-primary blueprint btn-xl contact-call">
          <Corners />
          {SITE.phone}
        </a>

        <table class="table spec-table">
          <caption class="visually-hidden">Contact details and service terms</caption>
          <tbody>
            <tr>
              <td class="t-label">Address</td>
              <td class="t-val">
                <address class="addr-plain">
                  {SITE.address.street}<br />
                  {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
                </address>
              </td>
            </tr>
            <tr><td class="t-label">Phone</td><td class="t-val"><a href={SITE.telHref}>{SITE.phone}</a></td></tr>
            {/* PLACEHOLDER: confirm hours, then add openingHoursSpecification in Schema.astro. */}
            <tr><td class="t-label">Hours</td><td class="t-val">Open 24 hours<br />Monday&ndash;Saturday</td></tr>
            <tr><td class="t-label">Sunday</td><td class="t-val">Closed</td></tr>
            <tr><td class="t-label">After hours</td><td class="t-val">Call the same number</td></tr>
            <tr><td class="t-label">Service area</td><td class="t-val">Idaho Falls, Ammon &amp; 50 miles</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <figure class="fig contact-map">
      <div class="blueprint map-panel">
        <Corners />
        <div class="map-frame"><ServiceMap /></div>
      </div>
      <figcaption>
        {SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
      </figcaption>
    </figure>
  </section>
</Base>

<style>
  .contact-intro {
    max-width: 820px;
    margin-bottom: 44px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    align-items: stretch;
  }

  .contact-card {
    height: 100%;
  }

  .contact-card--info {
    display: flex;
    flex-direction: column;
  }

  .contact-call {
    align-self: flex-start;
    margin: 2px 0 24px;
  }

  .contact-map {
    margin-top: 32px;
  }

  .contact-map .map-panel {
    aspect-ratio: 2 / 0.9;
    min-height: 420px;
  }

  @media (max-width: 820px) {
    .contact-intro {
      margin-bottom: 32px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .contact-map {
      margin-top: 24px;
    }

    .contact-map .map-panel {
      aspect-ratio: 1 / 1;
      min-height: 0;
    }
  }
</style>
