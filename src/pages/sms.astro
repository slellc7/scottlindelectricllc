---
import Base from '../layouts/Base.astro';
import Corners from '../components/Corners.astro';
import Crumb from '../components/Crumb.astro';
import PageHeading from '../components/PageHeading.astro';
import { SITE } from '../consts';
---

<Base
  title="SMS Opt-In Terms | Scott Lind Electric Service Updates"
  description="Opt in to Scott Lind Electric Service Updates. Text START to (208) 516-2090 for electrical-service messages. Message frequency varies. Message and data rates may apply. Consent is not a condition of purchase. Reply HELP for help or STOP to opt out."
  breadcrumb="SMS updates"
>
  <Crumb trail={['SMS updates']} />

  <section class="section section--page sms-page">
    <PageHeading kicker="Text messaging · Idaho Falls" size="h-page--sm" tight>
      Scott Lind Electric Service Updates
    </PageHeading>
    <p class="lead lead--narrow gap-lead">
      This is the public opt-in page for SMS messages from {SITE.name}. Text
      <strong>START</strong> to {SITE.smsPhone} to receive service updates.
    </p>

    <div class="sms-cta blueprint panel panel--tint">
      <Corners />
      <p class="sms-cta__label">How to opt in</p>
      <p class="sms-cta__command">Text START to {SITE.smsPhone}</p>
      <p class="sms-cta__consent">
        By texting START, you expressly consent to receive SMS messages from Scott Lind Electric
        at the mobile number you use.
      </p>
      <a class="btn btn-primary blueprint btn-lg" href={SITE.smsHref}>
        <Corners />
        Text START to {SITE.smsPhone}
      </a>
    </div>

    <article class="sms-copy">
      <section>
        <h2>What messages customers receive</h2>
        <p>
          Scott Lind Electric Service Updates messages concern electrical-service requests,
          scheduling, technician or service updates, follow-up questions, and related customer
          care. Messages may initially be handled by an AI assistant.
        </p>
      </section>

      <section class="sms-disclosures">
        <h2>Required disclosures</h2>
        <ul>
          <li>Message frequency varies.</li>
          <li>Message and data rates may apply.</li>
          <li>Consent is not a condition of purchase.</li>
          <li>Reply HELP for help or STOP to opt out.</li>
        </ul>
      </section>

      <section>
        <h2>Help and opt out</h2>
        <p>
          Reply <strong>STOP</strong> at any time to cancel. We may send one final message
          confirming that you have been unsubscribed. After that, you will not receive messages
          unless you opt in again by texting <strong>START</strong> to {SITE.smsPhone}.
        </p>
        <p>
          For assistance, reply <strong>HELP</strong>, call <a href={SITE.telHref}>{SITE.phone}</a>,
          or email <a href="mailto:scott@scottlindelectric.com">scott@scottlindelectric.com</a>.
          Carriers are not liable for delayed or undelivered messages.
        </p>
      </section>

      <section>
        <h2>Privacy Policy and Terms</h2>
        <p>
          Your participation is governed by our
          <a href="/privacy/">Privacy Policy</a>
          and
          <a href="/terms/">Terms and Conditions</a>.
          Mobile information, text-messaging originator opt-in data, and consent will not be
          shared with third parties or affiliates for their marketing or promotional purposes.
        </p>
        <p class="sms-legal-links">
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms and Conditions</a>
        </p>
      </section>
    </article>
  </section>
</Base>

<style>
  .sms-page { padding-bottom: 96px; }
  .sms-cta {
    max-width: 720px;
    margin: 0 0 48px;
    padding: 32px 28px;
    text-align: center;
  }
  .sms-cta__label {
    margin: 0 0 8px;
    font: 600 13px var(--font-heading);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-accent-700);
  }
  .sms-cta__command {
    margin: 0 0 14px;
    font: 600 clamp(1.7rem, 4vw, 2.6rem) / 1.15 var(--font-heading);
    text-transform: uppercase;
    letter-spacing: .03em;
    color: var(--color-text);
  }
  .sms-cta__consent {
    max-width: 48ch;
    margin: 0 auto 22px;
    line-height: 1.55;
    color: var(--color-text);
  }
  .sms-copy { max-width: 70ch; }
  .sms-copy section { padding: 28px 0; border-top: 1px solid var(--color-divider); }
  .sms-copy h2 { margin: 0 0 12px; font-size: clamp(1.4rem, 2vw, 1.85rem); text-transform: uppercase; }
  .sms-copy p { margin: 0 0 16px; line-height: 1.75; color: color-mix(in srgb, var(--color-text) 72%, transparent); }
  .sms-copy a { color: var(--color-accent); text-underline-offset: 3px; }
  .sms-disclosures { padding: 28px !important; border: 1px solid var(--color-divider) !important; background: var(--color-surface); }
  .sms-disclosures ul { margin: 0; padding: 0 0 0 1.2em; }
  .sms-disclosures li {
    margin: 0 0 10px;
    font-weight: 650;
    line-height: 1.5;
    color: var(--color-text);
  }
  .sms-disclosures li:last-child { margin-bottom: 0; }
  .sms-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 28px;
    margin: 0 !important;
    font-weight: 700;
  }
  @media (max-width: 820px) {
    .sms-page { padding-bottom: 64px; }
    .sms-cta { padding: 24px 18px; }
  }
</style>
