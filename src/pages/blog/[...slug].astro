---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Corners from '../../components/Corners.astro';
import Crumb from '../../components/Crumb.astro';
import CtaBand from '../../components/CtaBand.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props as Props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, heroImage, heroAlt } = post.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Only h2s — an in-post contents list of every h3 is noise.
const toc = headings.filter((h) => h.depth === 2);
---

<Base
  title={`${title} | Scott Lind Electric`}
  description={description}
  breadcrumb={title}
  ogType="article"
  article={{ title, description, pubDate, updatedDate, image: heroImage?.src }}
>
  <Crumb trail={[{ label: 'Blog', href: '/blog/' }, title]} />

  <article>
    <section class="section section--page">
      <div class="grid-lead grid-lead--even">
        <div>
          <p class="eyebrow eyebrow--sub">
            <span class="eyebrow-rule" aria-hidden="true"></span>
            <span class="eyebrow-text">
              <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
              {updatedDate && <> · Updated {fmt(updatedDate)}</>}
            </span>
          </p>
          <h1 class="h-page h-page--sm">{title}</h1>
          <p class="lead lead--narrow">{description}</p>
          {
            tags.length > 0 && (
              <div class="tag-row tag-row--spaced">
                {tags.map((t) => (
                  <span class="tag tag-outline">{t}</span>
                ))}
              </div>
            )
          }
        </div>

        {
          toc.length > 1 && (
            <nav class="blueprint panel panel--snug" aria-labelledby="post-toc">
              <Corners />
              <div class="u-num" id="post-toc">
                In this post
              </div>
              <div class="toc">
                {toc.map((h) => (
                  <a href={`#${h.slug}`}>
                    {h.text}
                  </a>
                ))}
              </div>
            </nav>
          )
        }
      </div>
    </section>

    {
      heroImage && (
        <section class="section section--tight">
          <div class="blueprint duotone fig-frame fig-frame--tall">
            <Corners />
            <Image src={heroImage} alt={heroAlt ?? ''} widths={[600, 1000, 1400]} sizes="(max-width: 700px) 100vw, 1200px" />
          </div>
        </section>
      )
    }

    <section class="section section--sub">
      <div class="post-body">
        <Content />
      </div>
    </section>
  </article>

  <CtaBand
    heading="Need this looked at?"
    copy="Free estimate, no service-call fee within 50 miles of Idaho Falls."
    secondary={{ href: '/contact/', label: 'Free estimate' }}
  />
</Base>
