---
import Base from '../layouts/Base.astro';
import Corners from '../components/Corners.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import { hasPhotos, heroImage, heroImageMobile } from '../data/photos';
import LiveReviews from '../components/LiveReviews.astro';
import { SITE } from '../consts';
import { homeFaqs } from '../data/faqs';
import { homeReviews } from '../data/reviews';

const services = [
  {
    num: 'Homeowners',
    title: 'Residential',
    href: '/residential/',
    cta: 'Residential service →',
    body: 'Outlets, switches, breakers that keep tripping, fixtures, remodels and additions. The small jobs other electricians are too busy for are the ones we take.',
    points: ['Outlet, switch & fixture repair', 'Breaker & panel trouble', 'Remodels & added circuits'],
    dark: false,
  },
  {
    num: 'Business',
    title: 'Commercial',
    href: '/commercial/',
    cta: 'Commercial work →',
    body: 'New construction, tenant remodels, service work, parking lot lights and LED conversions — scheduled around your hours, not ours.',
    points: ['Ground-up new construction', 'Parking lot & security lighting', 'Building maintenance & repair'],
    dark: false,
  },
  {
    num: 'Urgent',
    title: 'After hours',
    href: '/after-hours/',
    cta: 'Emergency service →',
    body: "Burning smell, sparking panel, a shop that can't open in the morning. Call and we'll do whatever we can to get you running.",
    points: ['Power loss & dead panels', 'Burning smells, sparks, heat', 'Business-critical downtime'],
    dark: true,
  },
];

const stats = [
  ['Same-day<br>service', 'Call in the morning, fixed the same day in most cases.'],
  ['No service<br>call fee', 'Within a 30-mile radius of Idaho Falls. You pay for the work, not the drive.'],
  ['Free<br>estimates', 'Scope and price before anyone picks up a tool.'],
  ['Open 24 hours<br>Mon&ndash;Sat', "Electrical problems don't keep business hours. Neither do we, six days a week."],
];

const capabilities = [
  'New construction', 'Remodels', 'Service & repair', 'After hours',
  'Parking lot & security lighting', 'Signs & canopies', 'LED conversions', 'Troubleshooting',
];

const towns = [
  ['Idaho Falls', true], ['Ammon', true], ['Ucon', false], ['Iona', false],
  ['Shelley', false], ['Rigby', false], ['Ririe', false], ['Roberts', false],
] as const;
---

<Base
  title="Idaho Falls Electrician — Same-Day | Scott Lind Electric"
  description="Licensed Idaho Falls electrician. Same-day residential, commercial and after-hours repair in Idaho Falls and Ammon. Free estimates, no service-call fee."
>
  {/* No faqs={} here on purpose. Three of the four questions in the block below
      are repeated verbatim on /answers/, and emitting FAQPage on both URLs puts
      the same Question entities on two pages. /answers/ owns them. */}
  <Hero
    image={heroImage}
    imageMobile={heroImageMobile}
    slogan={SITE.slogan}
    alt="Scott Lind Electric service van on the road outside Idaho Falls, Idaho"
    eyebrow="Idaho Falls electrician · Licensed & insured"
    headingLines={['No job too small.', 'Same-day repair.']}
    lead="Scott Lind Electric is a state-licensed electrical contractor serving Idaho Falls, Ammon and everywhere within 30 miles — residential, commercial and industrial. One dead outlet or a full build-out, you get the same answer: we'll come fix it."
    caption="Scott Lind Electric service van, Idaho Falls, ID"
    placeholder="Photo — service van"
  />

  <section class="section section--strip">
    <div class="u-grid stat-strip">
      {
        stats.map(([title, body]) => (
          <div class="stat">
            <h2 class="stat-title" set:html={title} />
            <p>{body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="rule-head rule-head--roomy">
      <h2>What we do</h2>
      <span class="rule-line" aria-hidden="true"></span>
      <span class="rule-note">Three ways to work with us</span>
    </div>

    <div class="grid-3">
      {
        services.map((s) => (
          <div class:list={['blueprint', 'svc-card', s.dark && 'svc-card--dark']}>
            <Corners />
            <div class="u-num">{s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <ul class="svc-list">
              {s.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <a href={s.href} class:list={['link-arrow', s.dark && 'link-arrow--invert']}>
              {s.cta}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="rule-head">
      <h2>Capabilities</h2>
      <span class="rule-line" aria-hidden="true"></span>
      <span class="rule-note">Residential · Commercial · Industrial</span>
    </div>
    <div class="u-grid cap-grid">
      {
        capabilities.map((label) => (
          <div class="cap-cell">
            <h3>{label}</h3>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band band--pad on-dark">
    <div class="band-inner">
      <div class="band-split">
        <div>
          <p class="eyebrow eyebrow--invert">
            <span class="eyebrow-rule" aria-hidden="true"></span>
            <span class="eyebrow-text">Answers before you call</span>
          </p>
          <h2 class="band-title">Straight answers, no phone tag.</h2>
          <p class="prose prose--tight">
            The questions Idaho Falls homeowners and shop owners actually ask us, answered in plain
            language.
          </p>
          <p class="after">
            <a href="/answers/" class="btn blueprint btn-on-dark btn-md">
              <Corners />
              All answers
            </a>
          </p>
        </div>

        <div class="qa-list">
          {
            homeFaqs.map(({ q, a }) => (
              <div class="qa-item">
                <h3>{q}</h3>
                <p>{a}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    hasPhotos && (
      <section class="section">
        <div class="rule-head recent-work-head">
          <h2>Recent work</h2>
          <span class="rule-line" aria-hidden="true" />
          <a href="/work/" class="link-arrow">
            All work →
          </a>
        </div>
        <Gallery carousel lightbox />
      </section>
    )
  }

  <section class="section">
    <div class="rule-head">
      <h2>What customers say</h2>
      <span class="rule-line" aria-hidden="true"></span>
      <a href="/reviews/" class="link-arrow">All reviews →</a>
    </div>
    <LiveReviews fallback={homeReviews} mode="home" />
  </section>

  <section class="section">
    <div class="blueprint panel-split">
      <Corners />

      <div class="panel-half">
        <div class="u-num">Service area</div>
        <h2>30 miles from<br />Idaho Falls</h2>
        <p class="prose prose--mid">
          Everything inside the radius is a no-service-call-fee call. Idaho Falls and Ammon are home
          ground; the surrounding Bonneville County towns are a short drive.
        </p>
        <div class="tag-row tag-row--spaced">
          {
            towns.map(([name, home]) => (
              <span class:list={['tag', home ? 'tag-accent' : 'tag-outline']}>{name}</span>
            ))
          }
        </div>
        <p class="after">
          <a href="/service-area/idaho-falls/" class="link-arrow">Electrician in Idaho Falls →</a>
        </p>
        <p class="after-sm">
          <a href="/service-area/ammon/" class="link-arrow">Electrician in Ammon →</a>
        </p>
        <p class="after-sm">
          <a href="/service-area/" class="link-arrow">All towns we cover →</a>
        </p>
      </div>

      <div class="panel-half panel-half--tint">
        <div class="u-num">Get in touch</div>
        <h2>Need electrical help?</h2>
        <p class="prose prose--mid">
          Call Scott directly, or use the Chat with us button to send the details of your electrical
          problem. For fire, smoke, shock, or immediate danger, call 911 first.
        </p>
        <p class="after">
          <a href={SITE.telHref} class="btn btn-primary blueprint btn-xl">Call {SITE.phone}</a>
        </p>
        <p class="after-sm">
          <a href="/contact/" class="link-arrow">Contact details →</a>
        </p>
      </div>
    </div>
  </section>
</Base>
