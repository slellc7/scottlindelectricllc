---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../consts';

/**
 * Full-bleed hero: the spec sheet laid over the photograph.
 *
 * The design system's language is technical drawing — registration marks,
 * hairline frames, Fig. numbers. So the photo is not a framed plate beside the
 * type; the type is a drawing *registered onto* the photo, with a viewfinder
 * frame inset over it and the numbered stat strip breaking the bottom edge.
 *
 * LEGIBILITY is not left to the photograph. A scrim of --color-accent-900 at
 * 88% sits under the type, which puts the worst case — pure white sky behind
 * it — at 8.6:1 against --color-bg (measured, not estimated). That clears WCAG AAA, so any photo
 * Scott sends works without anyone having to check.
 */
interface Props {
  image?: ImageMetadata;
  alt?: string;
  eyebrow: string;
  /** Each string is one line; they reveal in sequence on load. */
  headingLines: string[];
  lead: string;
  caption?: string;
  /** Placeholder text while no image exists. */
  placeholder?: string;
}

const {
  image,
  alt = '',
  eyebrow,
  headingLines,
  lead,
  caption,
  placeholder = 'Photo — service van',
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-media">
    {
      image ? (
        <Image
          src={image}
          alt={alt}
          widths={[800, 1400, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      ) : (
        <div class="hero-ph">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="2.5" y="4.5" width="19" height="15" /><circle cx="8.5" cy="10" r="1.8" />
            <path d="M3 17l5.5-5 4 3.5L16.5 11l4.5 4" />
          </svg>
          <span>{placeholder}</span>
        </div>
      )
    }
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-frame" aria-hidden="true">
    <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
  </div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow eyebrow--invert hero-r" style="--d:0ms">
        <span class="eyebrow-rule" aria-hidden="true"></span>
        <span class="eyebrow-text">{eyebrow}</span>
      </p>

      <h1 class="h-display hero-heading" id="hero-heading">
        {
          headingLines.map((line, i) => (
            <span class="hero-line">
              <span class="hero-r" style={`--d:${80 + i * 90}ms`}>{line}</span>
            </span>
          ))
        }
      </h1>

      <p class="lead hero-lead hero-r" style={`--d:${140 + headingLines.length * 90}ms`}>{lead}</p>

      <p class="hero-actions hero-r" style={`--d:${210 + headingLines.length * 90}ms`}>
        <a href={SITE.telHref} class="btn btn-primary blueprint btn-lg">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          Call {SITE.phone}
        </a>
        <a href="/contact/" class="btn btn-hero-ghost btn-lg">Request a free estimate</a>
      </p>
    </div>

    {caption && <p class="hero-caption">{caption}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    /* The supplied hero is a 2.93:1 banner (1905x650). A tall hero has to crop
       it hard horizontally and cuts the back of the van off. Height here tracks
       the source aspect (650/1905 = 34vw) with a floor for the copy, so at
       desktop widths the crop stays modest. */
    min-height: clamp(460px, 42vw, 600px);
    background: var(--color-accent-900);
    color: var(--color-bg);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .hero-media :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Shifted right: the van sits at roughly 33%-92% across the source, and the
       type sits over the left third, so the crop should eat sky, not vehicle. */
    object-position: 66% center;
    /* A very slow drift — enough to feel alive, not enough to notice working. */
    animation: hero-drift 26s ease-out both;
  }
  @keyframes hero-drift {
    from { transform: scale(1.005); }
    to   { transform: scale(1.055); }
  }

  .hero-ph {
    width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 12px;
    background:
      repeating-linear-gradient(45deg,
        color-mix(in srgb, var(--color-bg) 5%, transparent) 0 12px,
        transparent 12px 24px),
      var(--color-accent-800);
    color: color-mix(in srgb, var(--color-bg) 45%, transparent);
    font-family: var(--font-heading);
    font-size: 13px; letter-spacing: .16em; text-transform: uppercase;
  }
  .hero-ph svg { width: 38px; height: 38px; opacity: .55; }

  /* Two-layer scrim. The raking gradient carries the type; the flat wash keeps
     the far corner from blowing out on a bright sky. Both are accent-900, so
     the photo reads as tinted into the palette rather than merely darkened. */
  .hero-scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(
        76deg,
        color-mix(in srgb, var(--color-accent-900) 92%, transparent) 0%,
        /* Hold >=88% across the full width of .hero-copy (64%), so the tail of
           the longest heading line is still on 8.6:1 and not on open sky. */
        color-mix(in srgb, var(--color-accent-900) 88%, transparent) 66%,
        /* Fall off hard once past the copy — the van and the sky are the whole
           reason there's a photograph here. */
        color-mix(in srgb, var(--color-accent-900) 38%, transparent) 82%,
        color-mix(in srgb, var(--color-accent-900) 12%, transparent) 100%
      ),
      linear-gradient(
        to top,
        color-mix(in srgb, var(--color-accent-900) 55%, transparent) 0%,
        transparent 34%
      );
  }

  /* Viewfinder frame: the drawing registered onto the photograph. */
  .hero-frame {
    position: absolute;
    inset: 22px;
    z-index: 2;
    border: 1px solid color-mix(in srgb, var(--color-bg) 26%, transparent);
    pointer-events: none;
  }
  .hero-frame > .corner { color: color-mix(in srgb, var(--color-bg) 70%, transparent); }
  .hero-frame > .corner::before,
  .hero-frame > .corner::after { content: ""; position: absolute; background: currentColor; }
  .hero-frame > .corner::before { left: 5px; top: 0; width: 1px; height: 100%; }
  .hero-frame > .corner::after { top: 5px; left: 0; width: 100%; height: 1px; }
  .hero-frame > .corner { position: absolute; width: 11px; height: 11px; }
  .hero-frame > .corner.tl { top: -6px; left: -6px; }
  .hero-frame > .corner.tr { top: -6px; right: -6px; }
  .hero-frame > .corner.bl { bottom: -6px; left: -6px; }
  .hero-frame > .corner.br { bottom: -6px; right: -6px; }

  .hero-inner {
    position: relative;
    z-index: 3;
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
    padding: 84px 24px 76px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* A ch-based max-width here would resolve against the inherited 15px body
     size and crush the 84px display heading to ~310px. Constrain in px/%. */
  .hero-copy { max-width: min(760px, 64%); }

  .hero-heading {
    margin: 0 0 22px;
    color: var(--color-bg);
    text-shadow: 0 1px 24px color-mix(in srgb, var(--color-accent-900) 55%, transparent);
  }
  /* Each line clips its own reveal, so the type rises out of the rule above it. */
  .hero-line { display: block; overflow: hidden; }

  .hero-lead {
    color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    max-width: 52ch;
    margin: 0 0 30px;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; }

  /* Reversed-out secondary button — the light-theme .btn-secondary is invisible here. */
  :global(.btn-hero-ghost) {
    color: var(--color-bg);
    border-color: color-mix(in srgb, var(--color-bg) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent-900) 45%, transparent);
    backdrop-filter: blur(3px);
  }
  :global(.btn-hero-ghost:hover) {
    background: color-mix(in srgb, var(--color-bg) 14%, transparent);
    color: var(--color-bg);
    border-color: var(--color-bg);
  }

  .hero-caption {
    margin: 26px 0 0;
    font-size: 11px;
    color: color-mix(in srgb, var(--color-bg) 55%, transparent);
  }

  /* ── page-load reveal ──────────────────────────────────────────────────── */

  .hero-r {
    animation: hero-rise 620ms cubic-bezier(.22, .61, .36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(0.5em); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-r { animation: none; }
    .hero-media :global(.hero-img) { animation: none; transform: none; }
  }

  @media (max-width: 900px) {
    .hero { min-height: clamp(430px, 62vh, 560px); }
    .hero-inner { padding: 80px 24px 72px; }
    .hero-frame { inset: 14px; }
    .hero-copy { max-width: none; }
  }

  @media (max-width: 700px) {
    .hero-inner { padding: 64px 18px 60px; }
    .hero-lead { margin-bottom: 24px; }
    .hero-actions :global(.btn) { width: 100%; }
    /* At 375px the visible window is only ~27% of a 2.94:1 banner, so a crop
       centred on the graphic lands on half a letterform. Framing the cab keeps
       it reading as a van. */
    .hero-media :global(.hero-img) { object-position: 34% center; }

    /* A photo this dark at phone width needs the scrim flat, not raked —
       the diagonal leaves the last line of the heading on bare sky. */
    .hero-scrim {
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-accent-900) 93%, transparent) 0%,
        color-mix(in srgb, var(--color-accent-900) 86%, transparent) 55%,
        color-mix(in srgb, var(--color-accent-900) 62%, transparent) 100%
      );
    }
  }
</style>
