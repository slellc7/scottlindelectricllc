---
import { SITE } from '../consts';

const agentEndpoint = import.meta.env.PUBLIC_FIREBASE_AGENT_URL
  ?? 'https://us-central1-scott-lind-electric.cloudfunctions.net/serviceAgent';
---

<aside class="service-agent" data-service-agent data-endpoint={agentEndpoint}>
  <div class="service-agent__invite" data-agent-invite>
    <button class="service-agent__invite-close" type="button" data-agent-invite-close aria-label="Dismiss chat invitation">×</button>
    <strong><span aria-hidden="true">●</span> Electrical help available</strong>
    <p>Tell us what’s going on. Our AI assistant can collect the details for Scott.</p>
    <button class="service-agent__invite-action" type="button" data-agent-invite-open>Chat now</button>
  </div>

  <button class="service-agent__launcher" type="button" data-agent-open aria-expanded="false">
    <span aria-hidden="true">⚡</span>
    Chat with us
  </button>

  <section class="service-agent__panel" data-agent-panel hidden aria-label="Service call assistant">
    <header class="service-agent__header">
      <div>
        <strong>Electrical help assistant</strong>
        <span>Usually replies in a few seconds</span>
      </div>
      <div class="service-agent__header-actions">
        <button type="button" data-agent-close aria-label="Close service call assistant">×</button>
      </div>
    </header>

    <div class="service-agent__safety">
      Fire, smoke, shock, or a downed line? Move away and call 911 or your utility first.
    </div>

    <div class="service-agent__body" data-agent-body>
      <ol class="service-agent__messages" data-agent-messages aria-live="polite">
        <li class="service-agent__message service-agent__message--assistant">
          Hi — I’ll collect a few details and send your request to Scott Lind Electric. First, choose the options below.
        </li>
      </ol>

      <form class="service-agent__triage" data-agent-triage>
        <fieldset>
          <legend>Is there an immediate electrical danger?</legend>
          <label class="service-agent__choice">
            <input type="radio" name="safety" value="safe" required />
            <span>No fire, smoke, shock, burning smell, or active sparking</span>
          </label>
          <label class="service-agent__choice service-agent__choice--danger">
            <input type="radio" name="safety" value="emergency" required />
            <span>Yes — there is an immediate danger</span>
          </label>
        </fieldset>

        <fieldset data-property-choices>
          <legend>Is this residential or commercial?</legend>
          <div class="service-agent__choice-row">
            <label class="service-agent__choice">
              <input type="radio" name="serviceType" value="residential" />
              <span>Residential</span>
            </label>
            <label class="service-agent__choice">
              <input type="radio" name="serviceType" value="commercial" />
              <span>Commercial</span>
            </label>
          </div>
        </fieldset>

        <p class="service-agent__triage-error" data-triage-error hidden>Please choose residential or commercial.</p>
        <button class="btn btn-primary blueprint btn-md" type="submit">Continue</button>
      </form>

      <div class="service-agent__review" data-agent-review hidden>
      <strong>Review your request</strong>
      <dl data-agent-summary></dl>
      <label class="service-agent__consent">
        <input type="checkbox" data-agent-consent />
        <span>
          I agree to send these details to Scott Lind Electric and receive a confirmation and
          follow-up about this request by phone, text, or email. Message frequency varies.
          Message and data rates may apply. Consent is not a condition of purchase.
          Reply HELP for help or STOP to opt out.
          See our <a href="/sms/">SMS updates</a>,
          <a href="/privacy/">Privacy Policy</a>, and <a href="/terms/">Terms</a>.
        </span>
      </label>
      <button class="btn btn-primary blueprint btn-md" type="button" data-agent-submit disabled>
        Send my information
      </button>
      </div>

      <form class="service-agent__composer" data-agent-form hidden>
        <label class="visually-hidden" for="service-agent-message">Your message</label>
        <textarea id="service-agent-message" rows="2" maxlength="1500" data-agent-input required placeholder="Type your answer"></textarea>
        <button type="submit" aria-label="Send message">Send</button>
      </form>
      <p class="service-agent__error" data-agent-error hidden>
        The assistant couldn’t respond. Call <a href={SITE.telHref}>{SITE.phone}</a> instead.
      </p>
      <p class="service-agent__privacy">Don’t include payment details or sensitive personal information.</p>
    </div>
  </section>
</aside>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-service-agent]');
    if (!root) return;
    const openButton = root.querySelector('[data-agent-open]');
    const closeButton = root.querySelector('[data-agent-close]');
    const invite = root.querySelector('[data-agent-invite]');
    const inviteOpen = root.querySelector('[data-agent-invite-open]');
    const inviteClose = root.querySelector('[data-agent-invite-close]');
    const panel = root.querySelector('[data-agent-panel]');
    const scrollArea = root.querySelector('[data-agent-body]');
    const triageForm = root.querySelector('[data-agent-triage]');
    const propertyChoices = root.querySelector('[data-property-choices]');
    const triageError = root.querySelector('[data-triage-error]');
    const form = root.querySelector('[data-agent-form]');
    const input = root.querySelector('[data-agent-input]');
    const list = root.querySelector('[data-agent-messages]');
    const error = root.querySelector('[data-agent-error]');
    const review = root.querySelector('[data-agent-review]');
    const summary = root.querySelector('[data-agent-summary]');
    const consent = root.querySelector('[data-agent-consent]');
    const submitButton = root.querySelector('[data-agent-submit]');
    const endpoint = root.dataset.endpoint;
    const requestId = globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    const sendButton = form?.querySelector('button[type="submit"]');
    let lead = { name: null, phone: null, email: null, address: null, city: null, state: null, addressConfirmed: false, issue: null, serviceType: null };
    let audioContext = null;
    let audioUnlocked = false;
    let typingSoundTimer = null;
    const messages = [{ role: 'assistant', content: 'Hi — I’ll collect a few details and send your request to Scott Lind Electric. First, choose the options below.' }];
    try { invite.hidden = sessionStorage.getItem('service-agent-invite-dismissed') === 'true'; } catch {}

    const unlockAudio = async () => {
      if (audioUnlocked) return;
      const AudioContext = globalThis.AudioContext || globalThis.webkitAudioContext;
      if (!AudioContext) return;
      audioContext ??= new AudioContext();
      try {
        await audioContext.resume();
        audioUnlocked = audioContext.state === 'running';
      } catch {}
    };

    const playTone = (frequency, delay = 0, duration = .09, volume = .025) => {
      if (!audioUnlocked || audioContext?.state !== 'running') return;
      const start = audioContext.currentTime + delay;
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(frequency, start);
      gain.gain.setValueAtTime(.0001, start);
      gain.gain.exponentialRampToValueAtTime(volume, start + .012);
      gain.gain.exponentialRampToValueAtTime(.0001, start + duration);
      oscillator.connect(gain).connect(audioContext.destination);
      oscillator.start(start);
      oscillator.stop(start + duration + .02);
    };

    const playReplySound = () => {
      playTone(660, 0, .09, .025);
      playTone(880, .1, .12, .022);
    };

    const playTypingSound = () => {
      if (panel.hidden) return;
      playTone(420, 0, .045, .012);
      playTone(510, .18, .045, .011);
      playTone(600, .36, .045, .01);
    };

    document.addEventListener('pointerdown', unlockAudio, { capture: true });
    document.addEventListener('keydown', unlockAudio, { capture: true });

    const setOpen = (open) => {
      panel.hidden = !open;
      if (open) invite.hidden = true;
      openButton.setAttribute('aria-expanded', String(open));
      if (open) setTimeout(() => {
        const nextInput = !triageForm.hidden ? triageForm.querySelector('input') : !form.hidden ? input : closeButton;
        nextInput?.focus();
      }, 0);
      else openButton.focus();
    };

    const post = async (body) => {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);
      return result;
    };

    const setChatBusy = (busy) => {
      input.disabled = busy;
      sendButton.disabled = busy;
      sendButton.textContent = busy ? '…' : 'Send';
    };

    const addMessage = (role, content) => {
      const item = document.createElement('li');
      item.className = `service-agent__message service-agent__message--${role}`;
      item.textContent = content;
      list.append(item);
      messages.push({ role, content });
      if (role === 'assistant') playReplySound();
      requestAnimationFrame(() => { scrollArea.scrollTop = scrollArea.scrollHeight; });
    };

    const showTyping = () => {
      if (root.querySelector('[data-agent-typing]')) return;
      const item = document.createElement('li');
      item.className = 'service-agent__message service-agent__message--assistant service-agent__typing';
      item.dataset.agentTyping = '';
      item.setAttribute('aria-label', 'Assistant is typing');
      item.innerHTML = '<span></span><span></span><span></span>';
      list.append(item);
      playTypingSound();
      typingSoundTimer = globalThis.setInterval(playTypingSound, 1100);
      requestAnimationFrame(() => { scrollArea.scrollTop = scrollArea.scrollHeight; });
    };

    const hideTyping = () => {
      root.querySelector('[data-agent-typing]')?.remove();
      if (typingSoundTimer !== null) {
        globalThis.clearInterval(typingSoundTimer);
        typingSoundTimer = null;
      }
    };

    const showReview = () => {
      const values = [
        ['Name', lead.name], ['Phone', lead.phone], ['Email', lead.email],
        ['Location', lead.address],
        ['Problem', lead.issue],
      ].filter(([, value]) => value);
      summary.replaceChildren();
      for (const [label, value] of values) {
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = label;
        dd.textContent = value;
        summary.append(dt, dd);
      }
      review.hidden = false;
      form.hidden = true;
      review.scrollIntoView({ block: 'nearest' });
    };

    const applyAssistantResult = (result) => {
      lead = result.lead;
      addMessage('assistant', result.reply);
      if (result.ready && !result.emergency) {
        showReview();
      } else if (result.emergency || result.outOfArea) {
        form.hidden = true;
      } else {
        form.hidden = false;
      }
    };

    const requestAssistant = async () => {
      error.hidden = true;
      setChatBusy(true);
      showTyping();
      try {
        const result = await post({ action: 'chat', messages, lead });
        hideTyping();
        applyAssistantResult(result);
      } catch {
        hideTyping();
        error.hidden = false;
        form.hidden = false;
      } finally {
        setChatBusy(false);
        if (!form.hidden) input.focus();
      }
    };

    openButton.addEventListener('click', () => setOpen(panel.hidden));
    inviteOpen.addEventListener('click', () => setOpen(true));
    inviteClose.addEventListener('click', () => {
      invite.hidden = true;
      try { sessionStorage.setItem('service-agent-invite-dismissed', 'true'); } catch {}
    });
    closeButton.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) setOpen(false);
    });
    consent.addEventListener('change', () => { submitButton.disabled = !consent.checked; });

    triageForm.addEventListener('change', (event) => {
      if (event.target.name !== 'safety') return;
      const emergency = event.target.value === 'emergency';
      propertyChoices.hidden = emergency;
      triageError.hidden = true;
    });

    triageForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const triage = new FormData(triageForm);
      const safety = triage.get('safety');
      const serviceType = triage.get('serviceType');

      if (safety === 'emergency') {
        lead.serviceType = 'urgent';
        triageForm.hidden = true;
        form.hidden = true;
        addMessage('user', 'Yes — there is an immediate electrical danger.');
        addMessage('assistant', 'Move away from the hazard. If there is fire, smoke, injury, or immediate danger, call 911 now. For a downed line, stay well clear and call your utility. Once you are safe, call Scott Lind Electric at 208-716-1240.');
        return;
      }

      if (!serviceType) {
        triageError.hidden = false;
        propertyChoices.querySelector('input')?.focus();
        return;
      }

      lead.serviceType = serviceType;
      triageForm.hidden = true;
      addMessage('user', `No immediate danger. This is a ${serviceType} request.`);
      addMessage('assistant', 'Thanks. Please briefly describe the electrical problem.');
      form.hidden = false;
      input.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const content = input.value.trim();
      if (!content || !endpoint) return;
      addMessage('user', content);
      input.value = '';
      await requestAssistant();
    });

    submitButton.addEventListener('click', async () => {
      if (!consent.checked || !endpoint) return;
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
      error.hidden = true;
      try {
        const result = await post({ action: 'notify', lead, requestId, consent: consent.checked, source: `AI website assistant — ${location.pathname}` });
        review.hidden = true;
        form.hidden = true;
        const delivery = result.delivered === 2
          ? 'Your information was saved and sent to Scott Lind Electric.'
          : 'Your information was saved and sent to Scott Lind Electric, but one business alert needs attention.';
        const confirmations = result.customerConfirmations ?? {};
        const confirmation = confirmations.sms === 'sent' && confirmations.email === 'sent'
          ? 'A confirmation text and email are on the way.'
          : confirmations.sms === 'sent'
            ? 'A confirmation text is on the way.'
            : confirmations.email === 'sent'
              ? 'A confirmation email is on the way.'
              : 'We could not deliver a confirmation message, but Scott still received your request.';
        addMessage('assistant', `${delivery} ${confirmation} Scott will contact you directly. Taking you to the request confirmation page…`);
        globalThis.gtag?.('event', 'Chat_Form_Event', { method: 'ai_chat_form' });
        try { sessionStorage.setItem('service-request-submitted', 'chatbot'); } catch {}
        globalThis.setTimeout(() => { location.assign('/request-service/'); }, 2400);
      } catch {
        error.hidden = false;
        submitButton.disabled = false;
        submitButton.textContent = 'Send my information';
      }
    });
  })();
</script>

<style is:global>
  .service-agent { position: fixed; right: 20px; bottom: 20px; z-index: 80; font-family: var(--font-body); }
  .service-agent__invite { position: absolute; right: 0; bottom: calc(100% + 14px); z-index: 2; width: min(340px, calc(100vw - 24px)); padding: 20px 20px 18px; background: white; border: 1px solid var(--color-divider); box-shadow: 0 18px 48px rgba(10, 28, 43, .2); }
  .service-agent__invite[hidden] { display: none; }
  .service-agent__invite::after { content: ''; position: absolute; right: 36px; bottom: -9px; width: 16px; height: 16px; transform: rotate(45deg); background: white; border-right: 1px solid var(--color-divider); border-bottom: 1px solid var(--color-divider); }
  .service-agent__invite strong { display: block; padding-right: 28px; color: var(--color-accent-900); font: 600 18px var(--font-heading); text-transform: uppercase; letter-spacing: .03em; }
  .service-agent__invite strong span { color: #2ca66f; font-size: 12px; vertical-align: 2px; }
  .service-agent__invite p { margin: 10px 0 16px; color: color-mix(in srgb, var(--color-text) 72%, transparent); font-size: 14px; line-height: 1.45; }
  .service-agent__invite-close { position: absolute; top: 9px; right: 11px; border: 0; padding: 2px 6px; background: transparent; color: var(--color-text); font-size: 25px; line-height: 1; cursor: pointer; }
  .service-agent__invite-action { display: block; margin-left: auto; border: 0; padding: 11px 18px; background: var(--color-accent-900); color: white; font: 600 14px var(--font-heading); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; }
  .service-agent__invite-action:hover, .service-agent__invite-action:focus-visible { background: var(--color-accent-700); }
  .service-agent__launcher { position: relative; z-index: 1; border: 0; padding: 14px 18px; background: var(--color-accent-900); color: white; box-shadow: var(--shadow-lg); font: 600 15px var(--font-heading); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; animation: service-agent-bounce 5s ease-in-out infinite; }
  .service-agent__launcher[aria-expanded='true'] { animation-play-state: paused; }
  @keyframes service-agent-bounce {
    0%, 24%, 100% { transform: translateY(0); }
    6% { transform: translateY(-14px); }
    12% { transform: translateY(0); }
    18% { transform: translateY(-7px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-agent__launcher { animation: none; }
    .service-agent__typing span { animation: none; opacity: .55; }
  }
  .service-agent__panel { position: absolute; right: 0; bottom: calc(100% + 12px); z-index: 3; display: flex; flex-direction: column; width: min(390px, calc(100vw - 24px)); max-height: min(680px, calc(100vh - 110px)); overflow: hidden; background: var(--color-bg); border: 1px solid var(--color-divider); box-shadow: 0 20px 60px rgba(10, 28, 43, .24); }
  .service-agent__header { display: flex; flex: 0 0 auto; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px; background: var(--color-accent-900); color: white; }
  .service-agent__header strong, .service-agent__header span { display: block; }
  .service-agent__header strong { font: 600 19px var(--font-heading); text-transform: uppercase; letter-spacing: .04em; }
  .service-agent__header span { margin-top: 2px; font-size: 12px; opacity: .72; }
  .service-agent__header-actions { display: flex; align-items: center; gap: 8px; }
  .service-agent__header-actions button { border: 0; background: transparent; color: white; line-height: 1; cursor: pointer; }
  .service-agent__header-actions [data-agent-close] { padding: 2px; font-size: 28px; }
  .service-agent__safety { flex: 0 0 auto; padding: 10px 16px; background: #fff5df; color: #5b4010; border-bottom: 1px solid #e7d3aa; font-size: 12px; line-height: 1.35; }
  .service-agent__body { flex: 1 1 auto; min-height: 0; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  .service-agent__messages { display: flex; flex-direction: column; gap: 10px; min-height: 120px; margin: 0; padding: 16px; list-style: none; }
  .service-agent__message { max-width: 86%; padding: 10px 12px; font-size: 14px; line-height: 1.45; white-space: pre-wrap; }
  .service-agent__message--assistant { align-self: flex-start; background: #eef2f4; color: var(--color-text); }
  .service-agent__message--user { align-self: flex-end; background: var(--color-accent-900); color: white; }
  .service-agent__typing { display: inline-flex; align-items: center; gap: 5px; min-height: 16px; padding: 14px 16px; white-space: nowrap; }
  .service-agent__typing span { width: 7px; height: 7px; border-radius: 50%; background: color-mix(in srgb, var(--color-text) 48%, transparent); animation: service-agent-typing 1.1s ease-in-out infinite; }
  .service-agent__typing span:nth-child(2) { animation-delay: .18s; }
  .service-agent__typing span:nth-child(3) { animation-delay: .36s; }
  @keyframes service-agent-typing {
    0%, 80%, 100% { transform: translateY(0); opacity: .35; }
    40% { transform: translateY(-4px); opacity: 1; }
  }
  .service-agent__triage { margin: 0 16px 14px; padding: 14px; border: 1px solid var(--color-divider); background: #f7f9fa; }
  .service-agent__triage fieldset { min-width: 0; margin: 0 0 14px; padding: 0; border: 0; }
  .service-agent__triage legend { margin-bottom: 8px; font-size: 13px; font-weight: 700; }
  .service-agent__choice-row { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
  .service-agent__choice { display: flex; gap: 8px; align-items: flex-start; margin-bottom: 7px; padding: 10px; border: 1px solid var(--color-divider); background: white; font-size: 12px; line-height: 1.35; cursor: pointer; }
  .service-agent__choice:has(input:checked) { border-color: var(--color-accent-700); background: var(--color-accent-100); }
  .service-agent__choice input { flex: 0 0 auto; margin: 2px 0 0; accent-color: var(--color-accent-700); }
  .service-agent__choice--danger:has(input:checked) { border-color: #a33b2e; background: #fff0ed; }
  .service-agent__triage-error { margin: -4px 0 10px; color: #8a1c1c; font-size: 12px; }
  .service-agent__review { margin: 0 16px 14px; padding: 14px; border: 1px solid var(--color-divider); background: #f7f9fa; }
  .service-agent__review > strong { font: 600 16px var(--font-heading); text-transform: uppercase; }
  .service-agent__review dl { display: grid; grid-template-columns: 90px 1fr; gap: 4px 10px; margin: 10px 0; font-size: 12px; line-height: 1.4; }
  .service-agent__review dt { font-weight: 700; }
  .service-agent__review dd { margin: 0; overflow-wrap: anywhere; }
  .service-agent__consent { display: flex; gap: 8px; align-items: flex-start; margin: 12px 0; font-size: 11px; line-height: 1.4; }
  .service-agent__consent input { margin-top: 2px; }
  .service-agent__composer { display: grid; grid-template-columns: 1fr auto; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--color-divider); }
  .service-agent__composer textarea { resize: none; min-height: 44px; padding: 10px; border: 1px solid var(--color-divider); background: white; color: var(--color-text); font: inherit; }
  .service-agent__composer textarea:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .service-agent__composer button { border: 0; padding: 0 14px; background: var(--color-accent-700); color: white; font: 600 13px var(--font-heading); text-transform: uppercase; cursor: pointer; }
  .service-agent__composer button:disabled { opacity: .55; }
  .service-agent__error { margin: 0; padding: 0 16px 10px; color: #8a1c1c; font-size: 12px; }
  .service-agent__privacy { margin: 0; padding: 0 16px 12px; color: color-mix(in srgb, var(--color-text) 58%, transparent); font-size: 10px; }
  @media (max-width: 520px) {
    .service-agent { right: 12px; bottom: 12px; }
    .service-agent__panel {
      position: fixed;
      inset: 12px;
      width: auto;
      height: calc(100dvh - 24px);
      max-height: none;
    }
    .service-agent__messages { min-height: 0; }
    .service-agent__launcher { padding: 13px 15px; font-size: 13px; }
    .service-agent__invite { width: min(320px, calc(100vw - 24px)); padding: 18px; }
  }
</style>
