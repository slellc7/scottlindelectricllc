---
import { SITE } from '../consts';

const agentEndpoint = import.meta.env.PUBLIC_FIREBASE_AGENT_URL
  ?? 'https://us-central1-scott-lind-electric.cloudfunctions.net/serviceAgent';
---

<aside class="service-agent" data-service-agent data-endpoint={agentEndpoint}>
  <button class="service-agent__launcher" type="button" data-agent-open aria-expanded="false">
    <span aria-hidden="true">⚡</span>
    Chat with us
  </button>

  <section class="service-agent__panel" data-agent-panel hidden aria-label="Service call assistant">
    <header class="service-agent__header">
      <div>
        <strong>Electrical help assistant</strong>
        <span>Usually replies in a few seconds</span>
      </div>
      <button type="button" data-agent-close aria-label="Close service call assistant">×</button>
    </header>

    <div class="service-agent__safety">
      Fire, smoke, shock, or a downed line? Move away and call 911 or your utility first.
    </div>

    <ol class="service-agent__messages" data-agent-messages aria-live="polite">
      <li class="service-agent__message service-agent__message--assistant">
        Hi — tell me what electrical help you need and I’ll send your information to Scott Lind Electric. What’s happening?
      </li>
    </ol>

    <form class="service-agent__details" data-agent-details hidden>
      <strong data-agent-details-title>Your details</strong>

      <div class="service-agent__field" data-detail-field="name" hidden>
        <label for="service-agent-name">Name</label>
        <input id="service-agent-name" name="name" type="text" maxlength="100" autocomplete="name" data-detail-input="name" />
      </div>

      <div class="service-agent__field" data-detail-field="phone" hidden>
        <label for="service-agent-phone">Phone</label>
        <input id="service-agent-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" inputmode="tel" data-detail-input="phone" />
      </div>

      <div class="service-agent__field" data-detail-field="email" hidden>
        <label for="service-agent-email">Email <span>(optional)</span></label>
        <input id="service-agent-email" name="email" type="email" maxlength="200" autocomplete="email" data-detail-input="email" />
      </div>

      <div class="service-agent__field" data-detail-field="address" hidden>
        <label for="service-agent-address">Service address</label>
        <div class="service-agent__address-row">
          <input id="service-agent-address" name="address" type="search" maxlength="200" autocomplete="street-address" placeholder="Street, city, or ZIP" data-detail-input="address" />
          <button type="button" data-address-search>Look up</button>
        </div>
        <p class="service-agent__address-status" data-address-status aria-live="polite"></p>
        <div class="service-agent__address-results" data-address-results hidden aria-label="Address matches"></div>
        <small>Address lookup provided by the U.S. Census Bureau.</small>
      </div>

      <button class="btn btn-primary blueprint btn-md" type="submit" data-details-submit>
        Continue
      </button>
    </form>

    <div class="service-agent__review" data-agent-review hidden>
      <strong>Review your request</strong>
      <dl data-agent-summary></dl>
      <label class="service-agent__consent">
        <input type="checkbox" data-agent-consent />
        <span>
          I agree to send these details to Scott Lind Electric and be contacted about this request.
          See our <a href="/privacy/">Privacy Policy</a> and <a href="/terms/">Terms</a>.
        </span>
      </label>
      <button class="btn btn-primary blueprint btn-md" type="button" data-agent-submit disabled>
        Send my information
      </button>
    </div>

    <form class="service-agent__composer" data-agent-form>
      <label class="visually-hidden" for="service-agent-message">Your message</label>
      <textarea id="service-agent-message" rows="2" maxlength="1500" data-agent-input required placeholder="Describe the electrical problem"></textarea>
      <button type="submit" aria-label="Send message">Send</button>
    </form>
    <p class="service-agent__error" data-agent-error hidden>
      The assistant couldn’t respond. Call <a href={SITE.telHref}>{SITE.phone}</a> instead.
    </p>
    <p class="service-agent__privacy">Don’t include payment details or sensitive personal information.</p>
  </section>
</aside>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-service-agent]');
    if (!root) return;
    const openButton = root.querySelector('[data-agent-open]');
    const closeButton = root.querySelector('[data-agent-close]');
    const panel = root.querySelector('[data-agent-panel]');
    const form = root.querySelector('[data-agent-form]');
    const input = root.querySelector('[data-agent-input]');
    const list = root.querySelector('[data-agent-messages]');
    const error = root.querySelector('[data-agent-error]');
    const review = root.querySelector('[data-agent-review]');
    const summary = root.querySelector('[data-agent-summary]');
    const consent = root.querySelector('[data-agent-consent]');
    const submitButton = root.querySelector('[data-agent-submit]');
    const detailsForm = root.querySelector('[data-agent-details]');
    const detailsTitle = root.querySelector('[data-agent-details-title]');
    const detailsSubmit = root.querySelector('[data-details-submit]');
    const detailFields = [...root.querySelectorAll('[data-detail-field]')];
    const detailInputs = Object.fromEntries(
      [...root.querySelectorAll('[data-detail-input]')].map((element) => [element.dataset.detailInput, element]),
    );
    const addressSearch = root.querySelector('[data-address-search]');
    const addressStatus = root.querySelector('[data-address-status]');
    const addressResults = root.querySelector('[data-address-results]');
    const endpoint = root.dataset.endpoint;
    const requestId = globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    const sendButton = form?.querySelector('button[type="submit"]');
    let lead = { name: null, phone: null, email: null, address: null, city: null, issue: null, serviceType: null };
    let requestedFields = [];
    let selectedAddress = null;
    const messages = [{ role: 'assistant', content: 'Hi — tell me what electrical help you need and I’ll send your information to Scott Lind Electric. What’s happening?' }];

    const setOpen = (open) => {
      panel.hidden = !open;
      openButton.setAttribute('aria-expanded', String(open));
      if (open) setTimeout(() => {
        const detailInput = detailsForm.querySelector('[data-detail-field]:not([hidden]) input');
        (detailsForm.hidden ? input : detailInput)?.focus();
      }, 0);
      else openButton.focus();
    };

    const post = async (body) => {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);
      return result;
    };

    const setChatBusy = (busy) => {
      input.disabled = busy;
      sendButton.disabled = busy;
      sendButton.textContent = busy ? '…' : 'Send';
      detailsSubmit.disabled = busy;
    };

    const addMessage = (role, content) => {
      const item = document.createElement('li');
      item.className = `service-agent__message service-agent__message--${role}`;
      item.textContent = content;
      list.append(item);
      list.scrollTop = list.scrollHeight;
      messages.push({ role, content });
    };

    const showReview = () => {
      const values = [
        ['Name', lead.name], ['Phone', lead.phone], ['Email', lead.email],
        ['Location', [lead.address, lead.city].filter(Boolean).join(', ')],
        ['Problem', lead.issue],
      ].filter(([, value]) => value);
      summary.replaceChildren();
      for (const [label, value] of values) {
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = label;
        dd.textContent = value;
        summary.append(dt, dd);
      }
      review.hidden = false;
      detailsForm.hidden = true;
      form.hidden = true;
      review.scrollIntoView({ block: 'nearest' });
    };

    const renderDetails = (fields) => {
      requestedFields = fields.filter((field) => {
        if (field === 'address') return !lead.address;
        return !lead[field];
      });
      for (const wrapper of detailFields) {
        const active = requestedFields.includes(wrapper.dataset.detailField);
        wrapper.hidden = !active;
        const fieldInput = wrapper.querySelector('input');
        if (fieldInput) fieldInput.required = active && wrapper.dataset.detailField !== 'email';
      }
      if (!requestedFields.length) {
        detailsForm.hidden = true;
        form.hidden = false;
        input.focus();
        return;
      }
      detailsTitle.textContent = requestedFields.includes('address') ? 'Contact and service address' : 'Contact details';
      detailInputs.name.value = lead.name ?? '';
      detailInputs.phone.value = lead.phone ?? '';
      detailInputs.email.value = lead.email ?? '';
      detailInputs.address.value = lead.address ?? '';
      selectedAddress = lead.address ? { address: lead.address, city: lead.city } : null;
      addressStatus.textContent = '';
      addressResults.replaceChildren();
      addressResults.hidden = true;
      review.hidden = true;
      form.hidden = true;
      detailsForm.hidden = false;
      detailsForm.querySelector('[data-detail-field]:not([hidden]) input')?.focus();
    };

    const applyAssistantResult = (result) => {
      lead = result.lead;
      addMessage('assistant', result.reply);
      if (result.ready && !result.emergency) {
        showReview();
      } else if (!result.emergency) {
        renderDetails(Array.isArray(result.requestedFields) ? result.requestedFields : []);
      }
    };

    const requestAssistant = async () => {
      error.hidden = true;
      setChatBusy(true);
      try {
        const result = await post({ action: 'chat', messages, lead });
        applyAssistantResult(result);
      } catch {
        error.hidden = false;
        form.hidden = false;
      } finally {
        setChatBusy(false);
        if (!form.hidden) input.focus();
      }
    };

    const selectAddress = (match, button) => {
      selectedAddress = match;
      detailInputs.address.value = match.address;
      for (const option of addressResults.querySelectorAll('button')) option.setAttribute('aria-pressed', 'false');
      button.setAttribute('aria-pressed', 'true');
      addressStatus.textContent = 'Address selected.';
    };

    const showAddressMatches = (matches, enteredAddress) => {
      addressResults.replaceChildren();
      const options = matches.length ? matches : [{ address: enteredAddress, city: null }];
      for (const match of options) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'service-agent__address-option';
        button.textContent = matches.length ? match.address : `Use “${enteredAddress}”`;
        button.setAttribute('aria-pressed', 'false');
        button.addEventListener('click', () => selectAddress(match, button));
        addressResults.append(button);
      }
      addressResults.hidden = false;
      addressStatus.textContent = matches.length
        ? 'Select the correct address.'
        : 'No exact match was found. You can use the address as entered.';
    };

    openButton.addEventListener('click', () => setOpen(panel.hidden));
    closeButton.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) setOpen(false);
    });
    consent.addEventListener('change', () => { submitButton.disabled = !consent.checked; });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const content = input.value.trim();
      if (!content || !endpoint) return;
      addMessage('user', content);
      input.value = '';
      await requestAssistant();
    });

    addressSearch.addEventListener('click', async () => {
      const query = detailInputs.address.value.trim();
      if (query.length < 6 || !endpoint) {
        addressStatus.textContent = 'Enter a street address, city, or ZIP first.';
        return;
      }
      selectedAddress = null;
      addressSearch.disabled = true;
      addressSearch.textContent = 'Looking…';
      addressStatus.textContent = 'Looking for Idaho address matches…';
      addressResults.hidden = true;
      try {
        const result = await post({ action: 'addressSearch', query });
        showAddressMatches(result.matches ?? [], query);
      } catch {
        addressStatus.textContent = 'Address lookup is temporarily unavailable. Try again or call us.';
      } finally {
        addressSearch.disabled = false;
        addressSearch.textContent = 'Look up';
      }
    });

    detailInputs.address.addEventListener('input', () => {
      selectedAddress = null;
      addressResults.hidden = true;
      addressStatus.textContent = '';
    });

    detailsForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!detailsForm.reportValidity()) return;
      if (requestedFields.includes('address') && !selectedAddress) {
        addressStatus.textContent = 'Look up and select the service address before continuing.';
        detailInputs.address.focus();
        return;
      }
      if (requestedFields.includes('name')) lead.name = detailInputs.name.value.trim() || null;
      if (requestedFields.includes('phone')) lead.phone = detailInputs.phone.value.trim() || null;
      if (requestedFields.includes('email')) lead.email = detailInputs.email.value.trim() || null;
      if (requestedFields.includes('address')) {
        lead.address = selectedAddress.address;
        lead.city = selectedAddress.city;
      }
      const emailNote = requestedFields.includes('email') && !lead.email ? ' Email was left blank.' : '';
      detailsForm.hidden = true;
      addMessage('user', `I completed the requested form.${emailNote}`);
      await requestAssistant();
    });

    submitButton.addEventListener('click', async () => {
      if (!consent.checked || !endpoint) return;
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
      error.hidden = true;
      try {
        const result = await post({ action: 'notify', lead, requestId, source: `AI website assistant — ${location.pathname}` });
        review.hidden = true;
        form.hidden = true;
        const delivery = result.delivered === 2
          ? 'Your information was saved and sent to Scott Lind Electric by text and email.'
          : 'Your information was saved. One business alert needs attention, but Scott Lind Electric can still see your request.';
        addMessage('assistant', `${delivery} They’ll contact you directly.`);
      } catch {
        error.hidden = false;
        submitButton.disabled = false;
        submitButton.textContent = 'Send my information';
      }
    });
  })();
</script>

<style is:global>
  .service-agent { position: fixed; right: 20px; bottom: 20px; z-index: 80; font-family: var(--font-body); }
  .service-agent__launcher { border: 0; padding: 14px 18px; background: var(--color-accent-900); color: white; box-shadow: var(--shadow-lg); font: 600 15px var(--font-heading); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; }
  .service-agent__panel { position: absolute; right: 0; bottom: calc(100% + 12px); width: min(390px, calc(100vw - 24px)); max-height: min(680px, calc(100vh - 110px)); overflow: hidden; background: var(--color-bg); border: 1px solid var(--color-divider); box-shadow: 0 20px 60px rgba(10, 28, 43, .24); }
  .service-agent__header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px; background: var(--color-accent-900); color: white; }
  .service-agent__header strong, .service-agent__header span { display: block; }
  .service-agent__header strong { font: 600 19px var(--font-heading); text-transform: uppercase; letter-spacing: .04em; }
  .service-agent__header span { margin-top: 2px; font-size: 12px; opacity: .72; }
  .service-agent__header button { border: 0; background: transparent; color: white; font-size: 28px; line-height: 1; cursor: pointer; }
  .service-agent__safety { padding: 10px 16px; background: #fff5df; color: #5b4010; border-bottom: 1px solid #e7d3aa; font-size: 12px; line-height: 1.35; }
  .service-agent__messages { display: flex; flex-direction: column; gap: 10px; min-height: 180px; max-height: 280px; overflow-y: auto; margin: 0; padding: 16px; list-style: none; }
  .service-agent__message { max-width: 86%; padding: 10px 12px; font-size: 14px; line-height: 1.45; white-space: pre-wrap; }
  .service-agent__message--assistant { align-self: flex-start; background: #eef2f4; color: var(--color-text); }
  .service-agent__message--user { align-self: flex-end; background: var(--color-accent-900); color: white; }
  .service-agent__details { max-height: 310px; overflow-y: auto; margin: 0 16px 14px; padding: 14px; border: 1px solid var(--color-divider); background: #f7f9fa; }
  .service-agent__details > strong { display: block; margin-bottom: 10px; font: 600 16px var(--font-heading); text-transform: uppercase; }
  .service-agent__field { margin-bottom: 10px; }
  .service-agent__field[hidden] { display: none; }
  .service-agent__field label { display: block; margin-bottom: 4px; font-size: 12px; font-weight: 700; }
  .service-agent__field label span, .service-agent__field small { font-weight: 400; color: color-mix(in srgb, var(--color-text) 58%, transparent); }
  .service-agent__field input { width: 100%; min-height: 40px; padding: 8px 10px; border: 1px solid var(--color-divider); background: white; color: var(--color-text); font: inherit; }
  .service-agent__field input:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .service-agent__address-row { display: grid; grid-template-columns: 1fr auto; gap: 6px; }
  .service-agent__address-row button { border: 0; padding: 0 10px; background: var(--color-accent-700); color: white; font: 600 12px var(--font-heading); text-transform: uppercase; cursor: pointer; }
  .service-agent__address-row button:disabled { opacity: .55; }
  .service-agent__address-status { margin: 6px 0 0; font-size: 11px; line-height: 1.35; }
  .service-agent__address-results { display: grid; gap: 5px; margin-top: 7px; }
  .service-agent__address-results[hidden] { display: none; }
  .service-agent__address-option { width: 100%; border: 1px solid var(--color-divider); padding: 8px; background: white; color: var(--color-text); text-align: left; font: 500 11px/1.35 var(--font-body); cursor: pointer; }
  .service-agent__address-option[aria-pressed='true'] { border-color: var(--color-accent-700); background: var(--color-accent-100); }
  .service-agent__details > .btn { margin-top: 4px; }
  .service-agent__review { margin: 0 16px 14px; padding: 14px; border: 1px solid var(--color-divider); background: #f7f9fa; }
  .service-agent__review > strong { font: 600 16px var(--font-heading); text-transform: uppercase; }
  .service-agent__review dl { display: grid; grid-template-columns: 90px 1fr; gap: 4px 10px; margin: 10px 0; font-size: 12px; line-height: 1.4; }
  .service-agent__review dt { font-weight: 700; }
  .service-agent__review dd { margin: 0; overflow-wrap: anywhere; }
  .service-agent__consent { display: flex; gap: 8px; align-items: flex-start; margin: 12px 0; font-size: 11px; line-height: 1.4; }
  .service-agent__consent input { margin-top: 2px; }
  .service-agent__composer { display: grid; grid-template-columns: 1fr auto; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--color-divider); }
  .service-agent__composer textarea { resize: none; min-height: 44px; padding: 10px; border: 1px solid var(--color-divider); background: white; color: var(--color-text); font: inherit; }
  .service-agent__composer textarea:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .service-agent__composer button { border: 0; padding: 0 14px; background: var(--color-accent-700); color: white; font: 600 13px var(--font-heading); text-transform: uppercase; cursor: pointer; }
  .service-agent__composer button:disabled { opacity: .55; }
  .service-agent__error { margin: 0; padding: 0 16px 10px; color: #8a1c1c; font-size: 12px; }
  .service-agent__privacy { margin: 0; padding: 0 16px 12px; color: color-mix(in srgb, var(--color-text) 58%, transparent); font-size: 10px; }
  @media (max-width: 520px) {
    .service-agent { right: 12px; bottom: 12px; }
    .service-agent__panel {
      position: fixed;
      inset: 12px;
      width: auto;
      height: calc(100dvh - 24px);
      max-height: none;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }
    .service-agent__header { position: sticky; top: 0; z-index: 2; }
    .service-agent__messages { min-height: 0; max-height: none; overflow: visible; }
    .service-agent__details { max-height: none; overflow: visible; }
    .service-agent__launcher { padding: 13px 15px; font-size: 13px; }
  }
</style>
