---
/**
 * JSON-LD for the page.
 *
 * The Electrician (LocalBusiness) node carries a stable @id so every other
 * node — Service, BlogPosting — can reference the same business rather than
 * restating it.
 */
import { SITE } from '../consts';
import type { Faq } from '../data/faqs';

interface Props {
  canonical: string;
  description: string;
  breadcrumb?: string;
  /** Optional intermediate level, e.g. Home > Service area > Ammon. */
  breadcrumbParent?: { name: string; url: string };
  faqs?: Faq[];
  service?: string;
  article?: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    image?: string;
  };
}

const { canonical, description, breadcrumb, breadcrumbParent, faqs, service, article } = Astro.props;

const business = {
  '@type': 'Electrician',
  '@id': `${SITE.url}/#business`,
  name: SITE.legalName,
  url: `${SITE.url}/`,
  telephone: SITE.telephoneE164,
  // A photograph of the business, not the logo — Google asks for the real
  // thing here, and keeps `logo` separate for the knowledge panel.
  image: SITE.photos.map((p) => `${SITE.url}${p}`),
  logo: `${SITE.url}/images/sle-logo.png`,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: SITE.hours.open24,
      // Google's documented way to express "open 24 hours".
      opens: '00:00',
      closes: '23:59',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: SITE.hours.closed,
      // Both set to 00:00 marks the day as closed.
      opens: '00:00',
      closes: '00:00',
    },
  ],
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  hasMap: SITE.googleListing,
  // sameAs connects the website, Business Profile and official social account
  // as the same local business entity.
  sameAs: [SITE.googleListing, SITE.social.x],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  areaServed: SITE.areaServed.map((name) => ({ '@type': 'City', name })),
  description: SITE.description,
  slogan: SITE.slogan,
  makesOffer: SITE.services.map((name) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name },
  })),
};

const graph: Record<string, unknown>[] = [business];

if (breadcrumb) {
  const items = [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }];
  if (breadcrumbParent) {
    items.push({
      '@type': 'ListItem',
      position: 2,
      name: breadcrumbParent.name,
      item: new URL(breadcrumbParent.url, SITE.url).href,
    });
  }
  items.push({
    '@type': 'ListItem',
    position: items.length + 1,
    name: breadcrumb,
    item: canonical,
  });
  graph.push({ '@type': 'BreadcrumbList', itemListElement: items });
}

if (faqs?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}

if (service) {
  graph.push({
    '@type': 'Service',
    name: service,
    serviceType: service,
    url: canonical,
    provider: { '@id': `${SITE.url}/#business` },
    areaServed: SITE.areaServed.map((name) => ({ '@type': 'City', name })),
    description,
  });
}

if (article) {
  graph.push({
    '@type': 'BlogPosting',
    headline: article.title,
    description: article.description,
    datePublished: article.pubDate.toISOString(),
    dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
    url: canonical,
    mainEntityOfPage: canonical,
    ...(article.image ? { image: new URL(article.image, SITE.url).href } : {}),
    author: { '@id': `${SITE.url}/#business` },
    publisher: { '@id': `${SITE.url}/#business` },
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
