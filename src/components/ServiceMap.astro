  .ring { fill: none; stroke: var(--color-divider); stroke-width: 1; }
  .ring--edge { stroke: var(--color-accent); stroke-width: 1.5; }
  .spoke { stroke: var(--color-divider); stroke-width: 1; opacity: .45; }

  .ring-label {
    font-size: 16px; letter-spacing: .14em;
