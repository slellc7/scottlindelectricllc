  }
  .shop-sub {
    font-size: 16px; letter-spacing: .1em;
    fill: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  .town-dot { fill: var(--color-accent); }
  .leader { stroke: var(--color-divider); stroke-width: 1; }
  .town-label {
    font-size: 20px; letter-spacing: .06em; text-transform: uppercase;
    fill: var(--color-text);
  }
  .town-mi {
    font-size: 15px; letter-spacing: .1em;
    fill: color-mix(in srgb, var(--color-text) 48%, transparent);
  }

  .compass line, .compass path { stroke: var(--color-text); fill: var(--color-text); stroke-width: 1.2; }
  .compass text { font-size: 17px; letter-spacing: .1em; fill: var(--color-text); }
  .scale line { stroke: var(--color-text); stroke-width: 1.2; }
